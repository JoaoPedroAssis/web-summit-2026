format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/z01rb9lggyljfmrc5og1mu3rw9a6?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/z01rb9lggyljfmrc5og1mu3rw9a6?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/z01rb9lggyljfmrc5og1mu3rw9a6?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Policy Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"060f80ea-044f-46f2-a67d-e6c9dc67b106","slug":"it-takes-two-to-trust-operationalizing-public-private-security","title":"It takes two to trust: Operationalizing public-private security","description":"The cyber threat landscape is moving faster than ever, and waiting for a crisis to act is a losing strategy. Join leadership from Cisco and the NCSC for a candid conversation about why public-private partnerships are now a baseline survival requirement. Can radical transparency and shared operations turn reactive defence into active resilience, before the alarm sounds?","date":"November 12","starts_at":"2026-11-12T12:10:00Z","ends_at":"2026-11-12T12:30:00Z","duration":"","location":{"id":"0bfb2e82-760f-45dc-b560-0d0fbc4bd293","name":"Stage 8","venue":""},"timeslot_participations":[{"id":"","attendance_id":"1015bad4-5860-41b8-a0d8-d7121c9c0a0b","name":"Anthony Grieco","company_name":"Cisco Systems, Inc.","job_title":"SVP, Chief Security & Trust Officer","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/av0ubcb2r4o7rl6eon1j1h9h408o?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/av0ubcb2r4o7rl6eon1j1h9h408o?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/av0ubcb2r4o7rl6eon1j1h9h408o?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://we