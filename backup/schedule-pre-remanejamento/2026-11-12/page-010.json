{"data":{"listItems":[{"id":"d4cb15ed-5cb3-4d1a-8cbb-8f68a03252a5","slug":"the-world-builders-how-new-powers-are-reshaping-the-global-order","title":"The world builders: How new powers are reshaping the global order","description":"For five hundred years, power meant controlling territory. Today, the struggle is no longer over land. It is over the systems that shape the world: chips, AI, networks, platforms, and energy. This fireside chat explores how a handful of powers are building the infrastructure and rules that others must navigate. Most nations are players in a game they didn’t create. A few are world builders.","date":"November 12","starts_at":"2026-11-12T11:45:00Z","ends_at":"2026-11-12T12:05:00Z","duration":"","location":{"id":"a4486f66-1f6a-4e29-a0bb-8da491e4a712","name":"Stage 11","venue":""},"timeslot_participations":[{"id":"","attendance_id":"f284bdf6-a5af-4049-879a-03a6d67ac709","name":"Bruno Maçães","company_name":"Flint Global","job_title":"Geopolitical analyst, author and former Portuguese Secretary of State","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/a5hgn2xdpy1ix7g3dlfr9vfjqzed?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/a5hgn2xdpy1ix7g3dlfr9vfjqzed?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/a5hgn2xdpy1ix7g3dlfr9vfjqzed?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/a5hgn2xdpy1ix7g3dlfr9vfjqzed?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/a5hgn2xdpy1ix7g3dlfr9vfjqzed?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"35e6b9d6-626e-4a11-bd7c-eb2b8e45ee07","name":"Shrikesh Laxmidas","company_name":"ECO","job_title":"Deputy Editor-in-Chief","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/t5frlo5vp13ahmjwks8rww9fdeyy?ixlib=rails-4.3.1&auto=format&fit=crop&cr