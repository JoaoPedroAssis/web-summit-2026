edia","job_title":"Co-Founder/Contributing Editor","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/l068812t7il5zmh063c1gvzp18s2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/l068812t7il5zmh063c1gvzp18s2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/l068812t7il5zmh063c1gvzp18s2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/l068812t7il5zmh063c1gvzp18s2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/l068812t7il5zmh063c1gvzp18s2?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"96c5c75b-a343-4b02-8293-fbc4db8b7c68","name":"David Sirota","company_name":"The Lever","job_title":"Co-founder/Editor in Chief, and Oscar nominated screenwriter (Don't look up)","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/g7rkzjb19sr36qyedkmuht18rmye?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/g7rkzjb19sr36qyedkmuht18rmye?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/g7rkzjb19sr36qyedkmuht18rmye?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/g7rkzjb19sr36qyedkmuht18rmye?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/g7rkzjb19sr36qyedkmuht18rmye?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Policy Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"26295ff3-84c1-4329-84cb-7ca7aaa18fac","slug":"ai-vs-ai-the-battle-for-the-cyber-advantage","title":"AI vs. AI: The battle for the cyber advantage","description":"AI is now a tool, a target, and a force multiplier for modern adversaries. Operating at superhuman speed, it has overhauled the threat landscape, turning frontier AI capabilities into offensive tactics for nation-state actors and cybercriminals alike. Join CrowdStrike’s Zeki Turedi to explore the front lines of AI cyber warfare and learn how defenders can turn the tables to fight AI with AI.","date":"November 12","starts_at":"2026-11-12T10:05:00Z","ends_at":"2026-11-12T10:25:00Z","duration":"","location":{"id":"0bfb2e82-760f-45dc-b560-0d0fbc4bd293","name":"Stage 8","venue":""},"timeslot_participations":[{"id":"","attendance_id":"b64f6506-a902-43b8-aba3-8ce3e228f219","name":"Zeki Turedi","company_name":"CrowdStrike","job_title":"Field CTO for Europe, Middle East, and Africa","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/2qe3a9v9pb0kaytzvn3nioxwe606?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/2qe3a9v9pb0kaytzvn3nioxwe606?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/2qe3a9v9pb0kaytzvn3nioxwe606?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/2qe3a9v9pb0kaytzvn3nioxwe606?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/2qe3a9v9pb0kaytzvn3nioxwe606?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Cybersecurity Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"7f191c25-6a66-4cc2-9e56-1bbfdc2058e1","slug":"ready-or-not-here-ai-comes","title":"Ready or not here AI comes","description":"Every enterprise is racing to adopt AI. But fewer are asking the harder questions: is their infrastructure actually ready for AI, and can they remain resilient amid shifting geopolitical and regulatory pressures? Martin Schroeter discusses moving past pilots and into the operational realities of running AI reliably, securely and at scale.","date":"November 12","starts_at":"2026-11-12T10:10:00Z","ends_at":"2026-11-12T10:30:00Z","duration":"","location":{"id":"9c42fad4-f5a8-45cf-a373-69f6b6593329","name":"Stage 7","venue":""},"timeslot_participations":[{"id":"","attendance_id":"e7417936-de28-418d-ac34-120dd4250d44","name":"Martin Schroeter","company_name":"Kyndryl","job_title":"CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/wj245ctqpn2ezibtyvr7o6fpm5oj?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/wj245ctqpn2ezibtyvr7o6fpm5oj?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/wj245ctqpn2ezibtyvr7o6fpm5oj?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/wj245ctqpn2ezibtyvr7o6fpm5oj?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/wj245ctqpn2ezibtyvr7o6fpm5oj?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"1f9759ca-68f4-43d2-8f27-cddfe1bcf702","name":"Nuno Mateus-Coelho","company_name":"CNN Portugal","job_title":"Contributor CNN","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/u9pvtyjqbanmckcu18xrqghw519q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/u9pvtyjqbanmckcu18xrqghw519q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/u9pvtyjqbanmckcu18xrqghw519q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/u9pvtyjqbanmckcu18xrqghw519q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/u9pvtyjqbanmckcu18xrqghw519q?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"SaaS Summit","description":"","custom_order":0},"languages":[],"translatio