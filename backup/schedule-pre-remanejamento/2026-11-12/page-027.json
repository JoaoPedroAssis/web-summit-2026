n":{"id":"9fb135a5-3b1d-45b7-83e5-91185198ba16","name":"Meetup 5","venue":""},"timeslot_participations":[],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Meetup","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"8ed49b7f-140c-44e2-8f73-8758296533a6","slug":"italy-meetup","title":"🇮🇹 Italy meetup","description":"A space for Italians to connect at Web Summit 👋. Meet each other, exchange ideas, and mingle with people who get where you're from. See you there! \n\nUno spazio dedicato agli italiani al Web Summit 👋. Incontriamoci, scambiamoci idee e socializziamo con persone dello stesso paese. Ci vediamo lì!","date":"November 12","starts_at":"2026-11-12T16:00:00Z","ends_at":"2026-11-12T16:55:00Z","duration":"","location":{"id":"dbcc7fce-c386-44ac-8413-d38f8f32db58","name":"Meetup 1","venue":""},"timeslot_participations":[],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Meetup","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"70ebc778-7f2f-48b0-b2e8-79614a979592","slug":"integration-or-assimilation-the-immigration-debate","title":"Integration or assimilation? The immigration debate","description":"Immigration is reshaping European politics, with parties once on the margins now winning significant support amid public concern over housing, security and national identity. Governments have responded with measures ranging from tighter border controls to reduced work permits. Our panel asks: what do we expect of newcomers once they arrive? Should they adopt the host society’s culture and norms through assimilation, or should societies make room for cultural difference within a shared civic framework via integration?","date":"November 12","starts_at":"2026-11-12T16:00:00Z","ends_at":"2026-11-12T16:20:00Z","duration":"","location":{"id":"a4486f66-1f6a-4e29-a0bb-8da491e4a712","name":"Stage 11","venue":""},"timeslot_participations":[{"id":"","attendance_id":"d06cc14