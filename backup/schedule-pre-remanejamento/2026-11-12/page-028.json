,"avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/x0u85vp0zlg887xnc7oid15cibzo?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/x0u85vp0zlg887xnc7oid15cibzo?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/x0u85vp0zlg887xnc7oid15cibzo?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/x0u85vp0zlg887xnc7oid15cibzo?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/x0u85vp0zlg887xnc7oid15cibzo?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"3845eb02-ef5f-4d2f-b1c4-7c1fceae22a7","name":"Qian Hao","company_name":"Sina News","job_title":"Europe Bureau Chief","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/hiw8bvx3nz7q46v3w5bjbeeqqa5i?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/hiw8bvx3nz7q46v3w5bjbeeqqa5i?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/hiw8bvx3nz7q46v3w5bjbeeqqa5i?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/hiw8bvx3nz7q46v3w5bjbeeqqa5i?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/hiw8bvx3nz7q46v3w5bjbeeqqa5i?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Developer Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"3d031b2b-de69-4f5f-a8e7-6c705c22561e","slug":"critical-minerals-in-the-next-ai-frontier","title":"Critical minerals in the next AI frontier","description":"AI has fundamentally transformed the digital world, but that same transformation in the physical world is just beginning. Using mineral exploration as an example, Terra AI co-founder and CEO John Mern shows how combining domain science with frontier AI can unlock breakthroughs that traditional scaling can't reach. He highlights how these innovations are disrupting one of the oldest and most foundational heavy industries in the world, and identifies other underserved fields ready for similar disruption. For innovators and investors, the challenge made is to bet on humanity by building AI for the most critical physical-world problems.","date":"November 12","starts_at":"2026-11-12T16:27:00Z","ends_at":"2026-11-12T16:38:00Z","duration":"","location":{"id":"a871cf88-732c-432d-8969-1226f4fc575b","name":"Stage 9","venue":""},"timeslot_participations":[{"id":"","attendance_id":"8de8cc94-1c82-494f-960b-da1c0c4e11fc","name":"John Mern","company_name":"Terra AI","job_title":"Co-Founder & CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/f12yiiylop08q9rzb1k0bj2h8xol?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/f12yiiylop08q9rzb1k0bj2h8xol?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/f12yiiylop08q9rzb1k0bj2h8xol?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/f12yiiylop08q9rzb1k0bj2h8xol?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/f12yiiylop08q9rzb1k0bj2h8xol?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Growth Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"7596d61e-28ef-4279-8a6b-18340e4bca3a","slug":"insurtech-meetup","title":"🛡️ Insurtech meetup","description":"Insurance is ready for its tech moment 🛡️! Meet insurtech founders, insurers and investors, and swap notes on where the industry is heading. See you there!","date":"November 12","starts_at":"2026-11-12T16:30:00Z","ends_at":"2026-11-12T16:55:00Z","duration":"","location":{"id":"f27b2b4f-bd9d-46f8-af42-8370df6f6982","name":"Meetup 2","venue":""},"timeslot_participations":[],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Meetup","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"c73ae164-94c2-41c9-b9fd-eb8093fba74c","slug":"digital-transformation-and-dynamism-in-service-delivery","title":"Digital transformation and dynamism in service delivery","description":"How can governments and international organisations use digital technology to make public services faster, simpler and more accessible? This talk discusses how modernisation is increasingly taking the form of AI, digital identity and online services, along with the challenges around security, inclusion and implementation at scale.","date":"November 12","starts_at":"2026-11-12T16:40:00Z","ends_at":"2026-11-12T17:00:00Z","duration":"","location":{"id":"a4486f66-1f6a-4e29-a0bb-8da491e4a712","name":"Stage 11","venue":""},"timeslot_participations":[{"id":"","attendance_id":"50a31377-b467-4a4e-b3fc-e6cd80e411d9","name":"Luis Alberto Rodriguez","company_name":"Colombian Government","job_title":"Economist, and former Deputy Minister","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/846dhaib1ujaj19hctcqyi7m0cb4?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/846dhaib1ujaj19hctcqyi7m0cb4?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/846dhaib1ujaj19hctcqyi7m0cb4?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/846dhaib1ujaj19hctcqyi7m0cb4?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/846dhaib1ujaj19hctcqyi7m0cb4?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"9d4926e8-a9d0-4b36-8b87-b7fc9b91cdf8","name":"Tristan Thomas","company_name":"Department for Sci