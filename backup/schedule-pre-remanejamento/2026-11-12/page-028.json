{"data":{"listItems":[{"id":"4b9e0cd4-4395-4796-9f67-63ff50bae962","slug":"edtech-startups-meetup","title":"📚 Edtech startups meetup","description":"What's the next big shift in Edtech? Debate it with peers who are living it 🚀. Connect with peers shaping the future of your field. Looking forward to seeing you!","date":"November 12","starts_at":"2026-11-12T16:00:00Z","ends_at":"2026-11-12T16:55:00Z","duration":"","location":{"id":"6dec8fa2-b1c3-411f-92da-ef6ffe3b72ca","name":"Meetup 3","venue":""},"timeslot_participations":[],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Meetup","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"b742e8f7-343c-4868-8eac-4b488f1351d9","slug":"rebuilding-open-source-with-ai-lessons-learned","title":"Rebuilding open source with AI: Lessons Learned","description":"How we write software has fundamentally changed. Where we used to sweat over every little detail in source files, we now spend most of our time discussing high level direction with our agents. Prisma CEO Søren Bramer Schmidt shares lessons learned from rewriting Prisma from scratch with AI. Learn how to make the most of coding agents in 2026, and how the changing landscape affects open source libraries.","date":"November 12","starts_at":"2026-11-12T16:05:00Z","ends_at":"2026-11-12T16:25:00Z","duration":"","location":{"id":"685b779a-20e7-4280-b402-b239764fb6d6","name":"Stage 10","venue":""},"timeslot_participations":[{"id":"","attendance_id":"3f19cc38-1d8a-4c9d-ab2c-b00e61d2c17f","name":"Søren Bramer Schmidt","company_name":"Prisma","job_title":"CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/zztqk0p6v2yntsi297qxzf3w4av2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/zztqk0p6v2yntsi297qxzf3w4av2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/zztqk0p6v2yntsi297qxzf3w4av2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/zztqk0p6v2yntsi297qxzf3w4av2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/zztqk0p6v2yntsi297qxzf3w4av2?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Developer Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"81b6bd43-9124-44e1-af13-5385a63a086b","slug":"the-return-of-the-muckrakers","title":"The return of the muckrakers","description":"Investigative journalism serves a vital role in a truly democratic society. Exposing corruption, uncovering wrongdoing, and bringing the truth to light. In an increasingly unequal world, dominated by oligarchs, corrupt politicians, and artificial so-called intelligence, this vital work has taken on a new significance. In this session we will shine a light on what it takes to be a modern day muckraker.","date":"November 12","starts_at":"2026-11-12T16:20:00Z","ends_at":"2026-11-12T16:40:00Z","duration":"","location":{"id":"a4486f66-1f6a-4e29-a0bb-8da491e4a712","name":"Stage 11","venue":""},"timeslot_participations":[{"id":"","attendance_id":"d66d9f47-0a65-4667-8576-7e35f927e22e","name":"James Ball","company_name":"The New World","job_title":"Political Editor","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/q7yw90j0s2018q4p82yxbgk85y5x?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/q7yw90j0s2018q4p82yxbgk85y5x?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/q7yw90j0s2018q4p82yxbgk85y5x?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/q7yw90j0s2018q4p82yxbgk85y5x?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/q7yw90j0s2018q4p8