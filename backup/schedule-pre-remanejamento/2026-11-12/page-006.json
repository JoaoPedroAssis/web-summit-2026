":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"62d6cbc9-71cd-4411-8c0e-dd4ba765b0a7","slug":"mothers-building-in-tech-meetup","title":"👩‍👧 Mothers building in tech meetup","description":"Calling all mothers who are building in tech at Web Summit: your people are here! 🙌🏼. Exchange insights, discuss challenges, and expand your network. Join us!","date":"November 12","starts_at":"2026-11-12T11:00:00Z","ends_at":"2026-11-12T11:25:00Z","duration":"","location":{"id":"dbcc7fce-c386-44ac-8413-d38f8f32db58","name":"Meetup 1","venue":""},"timeslot_participations":[],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Meetup","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"4b4a439e-c93f-4217-8491-7e5798c71df9","slug":"the-100-million-prompt","title":"The $100 million prompt","description":"As generative video collapses production costs, e-commerce is entering a new era at the intersection of AI, entertainment, and performance, where products launch through AI-powered content, shoppable media, and episodic microdramas built to entertain and convert. ​This talk explores how AI is transforming not just how brands advertise, but how the next generation of commerce is built, launched and scaled.","date":"November 12","starts_at":"2026-11-12T11:00:00Z","ends_at":"2026-11-12T11:20:00Z","duration":"","location":{"id":"a2df2c35-bb0e-4872-a9e2-14c8aaa17d83","name":"Centre Stage","venue":""},"timeslot_participations":[{"id":"","attendance_id":"6b66a460-d2d5-4fd3-8fe4-872a422ade81","name":"Stephanie Liu","company_name":"Levitate Foundry","job_title":"CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/hqxph0g5lav0z38wc08yy4n3vpd4?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/hqxph0g5lav0z38wc08yy4n3vpd4?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/hqxph0g5lav0z38wc08yy4n3vpd4?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/hqxph0g5lav0z38wc08yy4n3vpd4?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/hqxph0g5lav0z38wc08yy4n3vpd4?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Centre Stage","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"1b010e55-f3e8-4163-a45a-9bdbad662f4c","slug":"you-onboarded-1-000-users-last-month-how-many-were-real","title":"You onboarded 1, 000 users last month. How many were real?","description":"Fake sign-ups used to have obvious tells: disposable emails, burner phone numbers. AI has erased most of those tells, and fraudulent accounts now pass the same checks real users do. That means skewed onboarding metrics and wasted ad spend, with fraud teams often unable to tell the difference until the damage is done. This session looks at what has changed in synthetic identity and bot-driven sign-up fraud. Matias Berny, Co-founder and CEO of Prelude, draws on data from more than 1 billion authntications to show which signals still separate real users from fake ones, and where older fraud checks fall short.","date":"November 12","starts_at":"2026-11-12T11:00:00Z","ends_at":"2026-11-12T11:10:00Z","duration":"","location":{"id":"a871cf88-732c-432d-8969-1226f4fc575b","name":"Stage 9","venue":""},"timeslot_participations":[{"id":"","attendance_id":"ffb658d8-35d2-46b5-9cb3-a885634e825b","name":"Matias Berny","company_name":"Prelude","job_title":"CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/8b9czbr7wsnu8q1ldn5lhmjc4eu7?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/8b9czbr7wsnu8q1ldn5lhmjc4eu7?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/8b9czbr7wsnu8q1ldn5lhmjc4eu7?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/8b9czbr7wsnu8q1ldn5lhmjc4eu7?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/8b9czbr7wsnu8q1ldn5lhmjc4eu7?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Growth Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"d78e5a3d-bb16-4d22-9c01-97e110c77981","slug":"how-software-ate-the-sim-unpacking-the-esim-transition","title":"How software ate the SIM: Unpacking the eSIM transition","description":"Although the eSIM was merely a spec sheet in 2016, more than 130 million travellers rely on it today. Emre Demirel, co-founder and CEO of Roamless, breaks down how software dismantled legacy telecom infrastructure and created a brand-new consumer category. Learn the critical signals that shaped the market's tipping point, and discover how telcos, travel platforms and app builders can use \"connectivity as a feature\" over the next decade.","date":"November 12","starts_at":"2026-11-12T11:10:00Z","ends_at":"2026-11-12T11:20:00Z","duration":"","location":{"id":"a871cf88-732c-432d-8969-1226f4fc575b","name":"Stage 9","venue":""},"timeslot_participations":[{"id":"","attendance_id":"e53b57ae-d3f7-4980-aebc-430190567bdd","name":"Emre Demirel","company_name":"Roamless","job_title":"Co-Founder & CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/uwk35zlqzdw6vynwkxjy93qryxci?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/uwk35zlqzdw6vynwkxjy93qryxci?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/uwk35zlqzdw6vynwkxjy93qryxci?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/uwk35zlqzdw6vynwkxjy93qryxci?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/uwk35zlqzdw6vynwkxjy93qryxci?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Growth Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"9bbc5c9c-2f97-4971-a675-803bde6adf3a","slug":"search-rebuilt-for-robots","title":"Search, rebuilt for robots","description":"Search was built for humans, not AI agents. Seltz is building the engine AI agent actually need. Will Wells spotted that early and backed it at Speedinvest; now he and founder Antonio Mallia talk about the bet, the friction, and what comes next.","date":"November 12","starts_at":"2026-11-12T11:10:00Z","ends_at":"2026-11-12T11:30:00Z","duration":"","location":{"id":"9c42fad4-f5a8-45cf-a373-69f6b6593329","name":"Stage 7","venue":""},"timeslot_participations":[{"id":"","attendance_id":"e76d8080-a2fe-4b96-984f-643e25186e49","name":"Antonio Mallia","company_name":"Seltz","job_title":"Founder & CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/4q9f3kxs01cg0on7kq5vxfidtmh2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/4q9f3kxs01cg0on7kq5vxfidtmh2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/4q9f3kxs01cg0on7kq5vxfidtmh2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/4q9f3kxs01cg0on7kq5vxfidtmh2?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/4q9f3kxs01cg0on7kq5vxfidtmh2?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"0cd8ecd0-8808-4022-9836-c459966ad7dc","name":"Will Wells","company_name":"Speedinvest","job_title":"Partner","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/kh2l9mdxsbu24fxenxfrpiwkgaq9?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/kh2l9mdxsbu24fxenxfrpiwkgaq9?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/kh2l9mdxsbu24fxenxfrpiwkgaq9?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/kh2l9mdxsbu24fxenxfrpiwkgaq9?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/kh2l9mdxsbu24fxenxfrpiwkgaq9?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"85513b19-094d-4768-bd26-49c428e7810a","name":"Andy O'Donoghue","company_name":"TodayFM","job_title":"Contributor","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/uxc97wl6uuyeyul9t72mpr9zqo6w?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/uxc97wl6uuyeyul9t72mpr9zqo6w?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/uxc97wl6uuyeyul9t72mpr9zqo6w?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/uxc97wl6uuyeyul9t72mpr9zqo6w?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/uxc97wl6uuyeyul9t72mpr9zqo6w?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"SaaS Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null}],"page":5,"nbPages":28,"maximumPages":32}}