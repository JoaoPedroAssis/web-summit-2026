{"data":{"listItems":[{"id":"b0b4dff3-a9b8-426e-810d-1d86f85a64a6","slug":"life-on-contentful-the-next-chapter","title":"Life on Contentful — The Next Chapter","description":"AI answers now shape how people discover brands, alongside search, websites, and apps. That shift is pushing companies to rethink how content, customer context, and AI work together without blurring what makes each brand distinctive. Join Contentful and TDC for a conversation about what to connect, what to protect, and how to prepare for AI’s growing role in the customer journey.","date":"November 12","starts_at":"2026-11-12T10:30:00Z","ends_at":"2026-11-12T10:55:00Z","duration":"","location":{"id":"c4becd02-1042-43fa-804f-814aef9a03fe","name":"Developer Lounge","venue":""},"timeslot_participations":[{"id":"","attendance_id":"d923a28d-ed7a-458f-863f-1e1179ca4727","name":"Maarten Dings","company_name":"Contentful","job_title":"Senior Solution Engineer","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/inhnc64k878to0imrft3ojisvthi?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/inhnc64k878to0imrft3ojisvthi?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/inhnc64k878to0imrft3ojisvthi?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/inhnc64k878to0imrft3ojisvthi?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/inhnc64k878to0imrft3ojisvthi?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Developer Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"9fd40607-9fe9-4805-9831-dfffb69c5e35","slug":"taming-the-agent-swarm","title":"Taming the agent swarm","description":"Multi-agent AI systems can draft entire features overnight, but they cannot establish policy, evaluate risk, or accept responsibility for a failed deployment. In this talk, JetBrains CEO Kirill Skrygan dissects the systemic failure modes of unconstrained agent swarms. He outlines a pragmatic blueprint for enterprise governance: combining real-time developer supervision, automated verification pipelines, and provenance to turn volatile AI output into reliable, enterprise-grade software.","date":"November 12","starts_at":"2026-11-12T10:30:00Z","ends_at":"2026-11-12T10:50:00Z","duration":"","location":{"id":"685b779a-20e7-4280-b402-b239764fb6d6","name":"Stage 10","venue":""},"timeslot_participations":[{"id":"","attendance_id":"52475f11-df18-4ba6-a33d-de6749683b02","name":"Kirill Skrygan","company_name":"JetBrains","job_title":"CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/f15lk6j6elini57szxlfzabkapl3?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/f15lk6j6elini57szxlfzabkapl3?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/f15lk6j6elini57szxlfzabkapl3?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/f15lk6j6elini57szxlfzabkapl3?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/f15lk6j6elini57szxlfzabkapl3?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Developer Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"8be63397-1451-4af9-b5f2-8ce947bc5cba","slug":"escaping-the-ai-pilot-purgatory","title":"Escaping the AI pilot purgatory","description":"Frontier models keep improving, but most enterprise AI isn't paying off. Most agentic pilots never reach production. Ashutosh argues the model was never the hard part. The real challenge is grounding AI in company context, defining success, building feedback loops that catch failures, and embedding governance from day one.","date":"November 12","starts_at":"2026-11-12T10:30:00Z","ends_at":"2026-11-12T10:50:00Z","duration":"","location":{"id":"9c42fad4-f5a8-45cf-a373-69f6b6593329","name":"Stage 7","venue":""},"timeslot_participations":[{"id":"","attendance_id":"d0e125c8-2808-4c80-8130-e677ece49c1d","name":"Ashutosh Kulkarni","company_name":"Elasticsearch Ltd","job_title":"CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/qepcf7v812824uq3e77rw8piq92q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/qepcf7v812824uq3e77rw8piq92q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/qepcf7v812824uq3e77rw8piq92q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/qepcf7v812824uq3e77rw8piq92q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/qepcf7v812824uq3e77rw8piq92q?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"2e5273b7-13bf-41c8-99e2-6a028e576507","name":"Flávio Nunes","company_name":"ECO","job_title":"Journalist","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/plcmhhrdyusds6g83ewvjd9v4hkh?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/plcmhhrdyusds6g83ewvjd9v4hkh?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/plcmhhrdyusds6g83ewvjd9v4hkh?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/plcmhhrdyusds6g83ewvjd9v4hkh?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/plcmhhrdyusds6g83ewvjd9v4hkh?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"SaaS Summit","description":"","custom_order":0},"languages":[],"t