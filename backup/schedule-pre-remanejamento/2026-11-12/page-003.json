&w=100&h=100","medium":"https://web-summit-engine.imgix.net/suon41dncqkjmdl7mgbhskrkda3o?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/suon41dncqkjmdl7mgbhskrkda3o?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/suon41dncqkjmdl7mgbhskrkda3o?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Masterclasses","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"546b586a-6354-4d90-8245-29545dde55a0","slug":"employee-to-equity-partner-how-podcasting-rewired-the-talent-deal","title":"Employee to equity partner: How podcasting rewired the talent deal","description":"Traditionally media outlets owned the content produced and talent got a salary or a fee but this has been replaced by something closer to a joint venture. This talk traces how podcasting made that shift possible, why hosts increasingly hold IP and equity stakes instead of just appearance fees, and what legacy and new outlets alike are having to renegotiate to keep top talent in the building.","date":"November 12","starts_at":"2026-11-12T10:30:00Z","ends_at":"2026-11-12T10:50:00Z","duration":"","location":{"id":"5635927d-b7a7-4537-9720-6746e34bbab8","name":"Stage 3","venue":""},"timeslot_participations":[{"id":"","attendance_id":"b1b16f91-5d8f-4920-8016-bda631657e5a","name":"Chris Peterson","company_name":"Red Seat Ventures","job_title":"VP, Business Development","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/v8bszpbiowbxrt0xugzo5sngo82h?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/v8bszpbiowbxrt0xugzo5sngo82h?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/v8bszpbiowbxrt0xugzo5sngo82h?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/v8bszpbiowbxrt0xugzo5sngo82h?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/v8bszpbiowbxrt0xugzo5sngo82h?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"5aa09f30-2058-40fa-be09-249bed44a993","name":"Stewart Clarke","company_name":"Deadline","job_title":"SVP, Content, International","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/faf5ya191fm25jhnrv60q67azlwu?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/faf5ya191fm25jhnrv60q67azlwu?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/faf5ya191fm25jhnrv60q67azlwu?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/faf5ya191fm25jhnrv60q67azlwu?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/faf5ya191fm25jhnrv60q67azlwu?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Creative Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"b30ff364-2923-401d-8797-876bf780c2ac","slug":"what-does-new-even-mean","title":"What does \"new\" even mean?","description":"For decades, commerce has been built around the idea that new is better. But resale is challenging how we think about newness, ownership, affordability and value. Using Vinted as a case study, this talk asks whether the next era of commerce can create growth not only by making more things, but by unlocking more value from the things that already exist.","date":"November 12","starts_at":"2026-11-12T10:35:00Z","ends_at":"2026-11-12T10:55:00Z","duration":"","location":{"id":"f42e279b-efba-48af-b96b-906241065ce2","name":"Stage 4","venue":""},"timeslot_participations":[{"id":"","attendance_id":"82f18129-44f2-4c17-855c-9460308d1b5c","name":"Andrew Smith","company_name":"Vinted","job_title":"Global Head of Brand","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/dsfpgawym378asxs4f3dm9bcxe7q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/dsfpgawym378asxs4f3dm9bcxe7q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/dsfpgawym378asxs4f3dm9bcxe7q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/dsfpgawym378asxs4f3dm9bcxe7q?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/dsfpgawym378asxs4f3dm9bcxe7q?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Commerce Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"7c1d3f45-a2b1-43d8-bd02-3cad53985b1f","slug":"built-to-last-the-reinvention-and-reimagining-of-iconic-brands","title":"Built to last: The reinvention and reimagining of iconic brands","description":"The most enduring brands aren’t the ones that stay the same. They're the ones that evolve without losing what people love about them. As a new CMCO taking a fresh look at one of marketing’s most iconic platforms – Priceless – Jill Kramer explores how marketers can balance consistency with innovation, stay relevant to new generations of consumers, and ensure their most valuable brand assets remain powerful for decades to come.","date":"November 12","starts_at":"2026-11-12T10:35:00Z","ends_at":"2026-11-12T10:55:00Z","duration":"","location":{"id":"716e89fb-86fe-4af9-a8c8-05a779333998","name":"Stage 14","venue":""},"timeslot_participations":[{"id":"","attendance_id":"3a19e290-083e-4aaf-9e6d-2f94a5029aab","name":"Jill Kramer","company_name":"Mastercard","job_title":"Chief Marketing & Communications Officer","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/c53z9jmlfrzmxqklj8apar0aiuc7?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/c53z9jmlfrzmxqklj8apar0aiuc7?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/c53z9jmlfrzmxqklj8apar0aiuc7?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/c53z9jmlfrzmxqklj8apar0aiuc7?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/c53z9jmlfrzmxqklj8apar0aiuc7?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"07c5f461-4afc-46a4-929e-6680d47adc12","name":"Chris Kelly","company_name":"Marketing Dive","job_title":"Reporter","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/txjsr3xeewwcpy4d1eyky4391qye?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/txjsr3xeewwcpy4d1eyky4391qye?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/txjsr3xeewwcpy4d1eyky4391qye?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/txjsr3xeewwcpy4d1eyky4391qye?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/txjsr3xeewwcpy4d1eyky4391qye?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Marketing Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null}],"page":2,"nbPages":28,"maximumPages":32}}