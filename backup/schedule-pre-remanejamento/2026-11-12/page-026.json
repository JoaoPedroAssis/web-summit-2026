w top organisations gain visibility over their AI infrastructure through practical strategies for discovering AI assets, implementing governance frameworks, orchestrating agent workflows and maintaining accountability in AI-driven decisions.","date":"November 12","starts_at":"2026-11-12T15:37:00Z","ends_at":"2026-11-12T15:48:00Z","duration":"","location":{"id":"a871cf88-732c-432d-8969-1226f4fc575b","name":"Stage 9","venue":""},"timeslot_participations":[{"id":"","attendance_id":"770add22-7f4e-4d16-97f2-88e9696d503b","name":"Kevin Kiley","company_name":"Airia AI","job_title":"CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/igepzmfgm6k2nh6uwkfx9onamajc?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/igepzmfgm6k2nh6uwkfx9onamajc?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/igepzmfgm6k2nh6uwkfx9onamajc?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/igepzmfgm6k2nh6uwkfx9onamajc?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/igepzmfgm6k2nh6uwkfx9onamajc?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Growth Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"a433a1bc-b53a-4689-a8f8-c7eb8088148c","slug":"search-built-for-ai-agents","title":"Search built for AI agents","description":"AI agents are on track to search the web more than humans, and their answers are only as good as the data they find. This session breaks down the infrastructure of agentic search and how it directly determines AI accuracy, speed, and cost.","date":"November 12","starts_at":"2026-11-12T15:40:00Z","ends_at":"2026-11-12T16:00:00Z","duration":"","location":{"id":"90a7d849-c0d0-473d-becf-b9cab8096e3d","name":"Stage 13","venue":""},"timeslot_participations":[{"id":"","attendance_id":"6f5ebc37-fbca-490f-bc46-4d94e81ee69e","name":"Will Bryk","company_name":"Exa","job_title":"Co-founder & CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/wxpdbk193qb07ivajwtqyl953rly?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/wxpdbk193qb07ivajwtqyl953rly?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/wxpdbk193qb07ivajwtqyl953rly?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/wxpdbk193qb07ivajwtqyl953rly?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/wxpdbk193qb07ivajwtqyl953rly?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"AI Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"7527cc4e-4620-4890-9542-d68f9434e7a1","slug":"deus-ex-machina-can-ai-replace-god","title":"Deus ex machina: Can AI replace God?","description":"Religion and mythology have been used, for millenia, to seize power. As AI progresses in its capabilities, the narratives around it are taking on an increasingly religious, or theistic, tone. In this session we explore how these shifts in language are used by elites to obtain and entrench their power. Can AI replace God, and if it can, what does that mean for us?","date":"November 12","starts_at":"2026-11-12T15:40:00Z","ends_at":"2026-11-12T16:00:00Z","duration":"","location":{"id":"a4486f66-1f6a-4e29-a0bb-8da491e4a712","name":"Stage 11","venue":""},"timeslot_participations":[{"id":"","attendance_id":"db5c3e34-33f6-4d99-8c3c-edd888d51127","name":"Remington Tonar","company_name":"Cart.com","job_title":"Co-Founder & Chief Growth Officer","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/0gb7zop5hgd3s4icir7vup42axvo?ixlib=rails-4.3.1&auto=format