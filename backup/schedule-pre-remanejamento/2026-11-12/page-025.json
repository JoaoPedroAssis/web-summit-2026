":null},{"id":"bc131cd3-e862-4d88-8855-909418fbdda1","slug":"entertainment-media-leaders-meetup","title":"🎬 Entertainment & media leaders meetup","description":"Join fellow media executives, entertainment founders and content leaders for a meetup! Come connect with people shaping the future of content, streaming and storytelling. See you there!","date":"November 12","starts_at":"2026-11-12T15:30:00Z","ends_at":"2026-11-12T15:55:00Z","duration":"","location":{"id":"f27b2b4f-bd9d-46f8-af42-8370df6f6982","name":"Meetup 2","venue":""},"timeslot_participations":[],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Meetup","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"29eb1f94-3a83-4628-9c33-89ef202e99b2","slug":"solo-founders-meetup","title":"🥷 Solo founders meetup","description":"Building a startup on your own? You don't have to network alone 🥷! Meet fellow solo founders, swap notes on doing it all and find people who get it. See you there!","date":"November 12","starts_at":"2026-11-12T15:30:00Z","ends_at":"2026-11-12T15:55:00Z","duration":"","location":{"id":"fc9cbd2c-9453-41b6-be58-a5129b35116a","name":"Meetup 4","venue":""},"timeslot_participations":[],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Meetup","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"01e26fb3-1e68-4dac-a64e-4d82f6644545","slug":"mobile-developers-meetup","title":"📲 Mobile developers meetup","description":"Building for the screen in everyone’s pocket? Meet iOS, Android and cross-platform developers, and swap notes on performance, app store wins and what users really tap on 📲 See you there!","date":"November 12","starts_at":"2026-11-12T15:30:00Z","ends_at":"2026-11-12T15:55:00Z","duration":"","location":{"id":"8d875587-df85-4a47-a3cf-fe6bc124700c","name":"Meetup 6","venue":""},"timeslot_participations":[],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Meetup","descripti