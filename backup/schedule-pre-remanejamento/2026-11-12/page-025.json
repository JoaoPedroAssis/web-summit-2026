sible? AI is accelerating targeted phishing, deepfake identity fraud, and data breaches. From corporate firewalls to global financial systems, traditional security perimeters are failing. This panel breaks down actionable self-defence strategies to empower enterprises, infrastructure leaders, and citizens to adapt, overcome, and thrive in an increasingly hostile cyber world.","date":"November 12","starts_at":"2026-11-12T15:35:00Z","ends_at":"2026-11-12T16:00:00Z","duration":"","location":{"id":"0bfb2e82-760f-45dc-b560-0d0fbc4bd293","name":"Stage 8","venue":""},"timeslot_participations":[{"id":"","attendance_id":"178a66d7-101a-4544-8382-6e811f0a1dab","name":"Gerasim Hovhannisyan","company_name":"EasyDMARC, Inc.","job_title":"Co-founder & CEO","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/tifi76k6kv0upu84t40x81ueu0z9?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/tifi76k6kv0upu84t40x81ueu0z9?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/tifi76k6kv0upu84t40x81ueu0z9?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/tifi76k6kv0upu84t40x81ueu0z9?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/tifi76k6kv0upu84t40x81ueu0z9?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"bd5f753f-ea6e-4eca-82ac-d4e06a9f0f97","name":"Sonia Azzouzi Boudie","company_name":"iBanFirst","job_title":"Chief of Tech & Strategy Officer","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/cygf0pohpphray3gsxk7erbbpebj?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/cygf0pohpphray3gsxk7erbbpebj?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/cygf0pohpphray3gsxk7erbbpebj?ixlib=rails-4.3.1&auto=format&fit=crop&c