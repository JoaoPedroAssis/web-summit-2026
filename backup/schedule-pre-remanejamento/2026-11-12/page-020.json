{"data":{"listItems":[{"id":"b284179b-b23b-4979-a7cd-3a902e5162f3","slug":"the-election-interference-we-don-t-talk-about","title":"The election interference we don't talk about","description":"Elections are no longer fought solely at the ballot box. They are contested on social media and online spaces. Here bots, troll farms and coordinated influence networks can shape public debate, amplify misleading narratives and manipulating perceptions of public opinion. This talk examines the Brazilian election, in addition to others. Beyond the headlines about misinformation, The Election Interference We Don’t Talk About asks a deeper question: who gets to shape the online conversation during an election, and what happens when the appearance of public opinion can be manufactured?","date":"November 12","starts_at":"2026-11-12T14:15:00Z","ends_at":"2026-11-12T14:35:00Z","duration":"","location":{"id":"a4486f66-1f6a-4e29-a0bb-8da491e4a712","name":"Stage 11","venue":""},"timeslot_participations":[{"id":"","attendance_id":"b60c910c-b177-4d0d-aa77-06e00b6a80fe","name":"Alan MacLeod","company_name":"Mint Press","job_title":"Senior Staff write Mint Press, author and member of the Glasgow University Media Group","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/ily212qxcl0mv3tb24v1h16trld1?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/ily212qxcl0mv3tb24v1h16trld1?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/ily212qxcl0mv3tb24v1h16trld1?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/ily212qxcl0mv3tb24v1h16trld1?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/ily212qxcl0mv3tb24v1h16trld1?ixlib=rails-4.3.1"}},{"id":"","attendance_id":"48b0640e-b13f-47cf-933a-3903debe2e16","name":"Anna Nemtsova","company_name":"The Daily Beast","job_title":"Foreign Correspondent","role":"","avatar_urls":{"tiny":null,"thumb":null,"medium":null,"large":null,"original":null}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Policy Summit","description":"","custom_order":0},"languages":[],"translations":{},"livevoice_url":null},{"id":"a85423ae-74a7-4ee7-99d9-09df9554d6cb","slug":"what-ai-can-do-for-humanity","title":"What AI can do for humanity","description":"In a tech landscape dominated by conversations about speed, efficiency, and scaling models, it’s easy to lose sight of why we build. Join Rodrigo Moran, Global Director of Creative at Microsoft as he cuts through the noise of AI hype to focus on what matters most: human-centric purpose. Discover how we can move beyond mere automation to design a future where AI truly serves humanity.","date":"November 12","starts_at":"2026-11-12T14:15:00Z","ends_at":"2026-11-12T14:35:00Z","duration":"","location":{"id":"5635927d-b7a7-4537-9720-6746e34bbab8","name":"Stage 3","venue":""},"timeslot_participations":[{"id":"","attendance_id":"cc320cec-c48b-4460-be0f-4e9c7483f6e3","name":"Rodrigo Moran","company_name":"Microsoft","job_title":"Global Director of Creative","role":"","avatar_urls":{"tiny":"https://web-summit-engine.imgix.net/eozvzei8sghfhq6t88yphft1x8kc?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=48&h=48","thumb":"https://web-summit-engine.imgix.net/eozvzei8sghfhq6t88yphft1x8kc?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=100&h=100","medium":"https://web-summit-engine.imgix.net/eozvzei8sghfhq6t88yphft1x8kc?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=300&h=300","large":"https://web-summit-engine.imgix.net/eozvzei8sghfhq6t88yphft1x8kc?ixlib=rails-4.3.1&auto=format&fit=crop&crop=faces&w=600&h=600","original":"https://web-summit-engine.imgix.net/eozvzei8sghfhq6t88yphft1x8kc?ixlib=rails-4.3.1"}}],"conferenceSlug":"lis26","schedule_track":{"id":"","name":"Creative Summit","description":"","custom_order":0},"languages":[],"translatio